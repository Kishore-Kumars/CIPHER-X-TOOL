# -----------------------------------------------------------------
# IPINFO - Supports IP
# -----------------------------------------------------------------


def test_ipinfo_supports_ip():

    provider = IPInfoProvider()

    assert provider.supports("ip")


# -----------------------------------------------------------------
# IPINFO - Invalid IP
# -----------------------------------------------------------------


def test_ipinfo_rejects_invalid_ip(monkeypatch):

    monkeypatch.setattr(
        "app.intelligence.providers.ipinfo.get_settings",
        lambda: type(
            "Settings",
            (),
            {
                "ipinfo_token": "test-token",
                "threat_intel_timeout_seconds": 5,
            },
        )(),
    )

    provider = IPInfoProvider()

    result = provider.lookup(
        indicator="999.999.999.999",
        indicator_type="ip",
    )

    assert result.status == "invalid"

    assert (
        result.provider
        == "ipinfo_lite"
    )


# -----------------------------------------------------------------
# IPINFO - Successful API Response
# -----------------------------------------------------------------


def test_ipinfo_success(monkeypatch):

    class MockResponse:

        def raise_for_status(self):
            pass

        def json(self):

            return {
                "ip": "8.8.8.8",
                "country_code": "US",
                "country": "United States",
                "continent_code": "NA",
                "continent": "North America",
                "asn": "AS15169",
                "as_name": "Google LLC",
                "as_domain": "google.com",
            }

    def mock_get(*args, **kwargs):

        return MockResponse()

    monkeypatch.setattr(
        "app.intelligence.providers.ipinfo.httpx.get",
        mock_get,
    )

    monkeypatch.setattr(
        "app.intelligence.providers.ipinfo.get_settings",
        lambda: type(
            "Settings",
            (),
            {
                "ipinfo_token": "test-token",
                "threat_intel_timeout_seconds": 5,
            },
        )(),
    )

    provider = IPInfoProvider()

    result = provider.lookup(
        indicator="8.8.8.8",
        indicator_type="ip",
    )

    assert result.status == "success"

    assert (
        result.provider
        == "ipinfo_lite"
    )

    assert (
        result.reputation
        == "unknown"
    )

    assert result.confidence == 0.90

    assert (
        result.data["country_code"]
        == "US"
    )

    assert (
        result.data["country"]
        == "United States"
    )

    assert (
        result.data["continent_code"]
        == "NA"
    )

    assert (
        result.data["continent"]
        == "North America"
    )

    assert (
        result.data["asn"]
        == "AS15169"
    )

    assert (
        result.data["as_name"]
        == "Google LLC"
    )

    assert (
        result.data["as_domain"]
        == "google.com"
    )

    assert len(result.evidence) == 3


# -----------------------------------------------------------------
# IPINFO - HTTP Error
# -----------------------------------------------------------------


def test_ipinfo_http_error(monkeypatch):

    class MockResponse:

        status_code = 401

        def raise_for_status(self):

            request = httpx.Request(
                "GET",
                "https://api.ipinfo.io/lite/8.8.8.8",
            )

            response = httpx.Response(
                401,
                request=request,
            )

            raise httpx.HTTPStatusError(
                "Unauthorized",
                request=request,
                response=response,
            )

    def mock_get(*args, **kwargs):

        return MockResponse()

    monkeypatch.setattr(
        "app.intelligence.providers.ipinfo.httpx.get",
        mock_get,
    )

    monkeypatch.setattr(
        "app.intelligence.providers.ipinfo.get_settings",
        lambda: type(
            "Settings",
            (),
            {
                "ipinfo_token": "invalid-token",
                "threat_intel_timeout_seconds": 5,
            },
        )(),
    )

    provider = IPInfoProvider()

    result = provider.lookup(
        indicator="8.8.8.8",
        indicator_type="ip",
    )

    assert result.status == "error"

    assert "401" in result.errors[0]


# -----------------------------------------------------------------
# IPINFO - Network Error
# -----------------------------------------------------------------


def test_ipinfo_network_error(monkeypatch):

    def mock_get(*args, **kwargs):

        raise httpx.ConnectError(
            "Connection failed"
        )

    monkeypatch.setattr(
        "app.intelligence.providers.ipinfo.httpx.get",
        mock_get,
    )

    monkeypatch.setattr(
        "app.intelligence.providers.ipinfo.get_settings",
        lambda: type(
            "Settings",
            (),
            {
                "ipinfo_token": "test-token",
                "threat_intel_timeout_seconds": 5,
            },
        )(),
    )

    provider = IPInfoProvider()

    result = provider.lookup(
        indicator="8.8.8.8",
        indicator_type="ip",
    )

    assert result.status == "error"

    assert (
        "IPinfo request error"
        in result.errors[0]
    )


