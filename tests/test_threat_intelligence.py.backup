# -----------------------------------------------------------------
# IPINFO - Correct Request
# -----------------------------------------------------------------


def test_ipinfo_sends_correct_request(
    monkeypatch,
):

    captured = {}

    class MockResponse:

        def raise_for_status(self):
            pass

        def json(self):

            return {
                "ip": "8.8.8.8",
                "country_code": "US",
                "country": "United States",
                "continent_code": "NA",
                "continent": "North America",
                "asn": "AS15169",
                "as_name": "Google LLC",
                "as_domain": "google.com",
            }

    def mock_get(
        url,
        params,
        timeout,
    ):

        captured["url"] = url
        captured["params"] = params
        captured["timeout"] = timeout

        return MockResponse()

    monkeypatch.setattr(
        "app.intelligence.providers.ipinfo.httpx.get",
        mock_get,
    )

    monkeypatch.setattr(
        "app.intelligence.providers.ipinfo.get_settings",
        lambda: type(
            "Settings",
            (),
            {
                "ipinfo_token": "test-token",
                "threat_intel_timeout_seconds": 7,
            },
        )(),
    )

    provider = IPInfoProvider()

    result = provider.lookup(
        indicator="8.8.8.8",
        indicator_type="ip",
    )

    assert result.status == "success"

    assert (
        captured["url"]
        == "https://api.ipinfo.io/lite/8.8.8.8"
    )

    assert (
        captured["params"]["token"]
        == "test-token"
    )

    assert captured["timeout"] == 7


# -----------------------------------------------------------------
# IPINFO - Whitespace Handling
# -----------------------------------------------------------------


def test_ipinfo_strips_whitespace(
    monkeypatch,
):

    class MockResponse:

        def raise_for_status(self):
            pass

        def json(self):

            return {
                "country_code": "US",
                "country": "United States",
                "continent_code": "NA",
                "continent": "North America",
                "asn": "AS15169",
                "as_name": "Google LLC",
                "as_domain": "google.com",
            }

    def mock_get(
        url,
        params,
        timeout,
    ):

        assert (
            url
            == "https://api.ipinfo.io/lite/8.8.8.8"
        )

        return MockResponse()

    monkeypatch.setattr(
        "app.intelligence.providers.ipinfo.httpx.get",
        mock_get,
    )

    monkeypatch.setattr(
        "app.intelligence.providers.ipinfo.get_settings",
        lambda: type(
            "Settings",
            (),
            {
                "ipinfo_token": "test-token",
                "threat_intel_timeout_seconds": 5,
            },
        )(),
    )

    provider = IPInfoProvider()

    result = provider.lookup(
        indicator="  8.8.8.8  ",
        indicator_type="ip",
    )

    assert result.status == "success"

    assert (
        result.indicator
        == "8.8.8.8"
    )


# =================================================================
# DEFAULT SERVICE TEST
# =================================================================


def test_default_service_has_ip_providers():

    service = (
        create_default_threat_intelligence_service()
    )

    ip_providers = (
        service.get_providers_for_indicator("ip")
    )

    provider_names = {
        provider.name
        for provider in ip_providers
    }

    assert (
        "ipinfo_lite"
        in provider_names
    )

    assert (
        "abuseipdb"
        in provider_names
    )